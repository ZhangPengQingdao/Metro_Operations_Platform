{
  "id": "todos",
  "name": "待办事项",
  "version": "1.2.0",
  "description": "工班待办、车站和人员子项、周期自动任务",
  "color": "#2563EB",
  "platform": ">=1.6.0 <2.0.0",
  "permissions": [
    {
      "code": "read",
      "name": "查看待办",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "create",
      "name": "发布普通待办",
      "scopes": [
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "handle",
      "name": "办理待办子项",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "manage",
      "name": "修改及删除待办",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "recurring",
      "name": "管理周期模板",
      "scopes": [
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "score",
      "name": "设置任务分值",
      "scopes": [
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    }
  ],
  "platformAccess": [
    "people.read",
    "locations.read",
    "tools.read"
  ],
  "pages": [
    {
      "path": "/",
      "title": "待办事项",
      "permission": "read",
      "nav": true
    },
    {
      "path": "/recurring",
      "title": "周期待办",
      "permission": "recurring",
      "nav": true
    }
  ],
  "api": [
    {
      "id": "session"
    },
    {
      "id": "directory"
    },
    {
      "id": "list"
    },
    {
      "id": "detail"
    },
    {
      "id": "create-task",
      "permission": "create"
    },
    {
      "id": "update-task",
      "permission": "manage"
    },
    {
      "id": "delete-task",
      "permission": "manage"
    },
    {
      "id": "handle-item"
    },
    {
      "id": "save-template",
      "permission": "recurring"
    },
    {
      "id": "template-state",
      "permission": "recurring"
    },
    {
      "id": "trigger"
    },
    {
      "id": "dashboard-summary",
      "permission": "read",
      "dashboard": true
    },
    {
      "id": "agent-todos",
      "permission": "read"
    },
    {
      "id": "tool-list-todos",
      "permission": "read"
    }
  ],
  "limits": {
    "memoryMiB": 128,
    "timeoutSeconds": 30
  },
  "agents": [
    {
      "id": "list-todos",
      "name": "查看待办事项",
      "description": "查看当前员工权限范围内最近的未完成或已完成待办。仅按这两种状态查询，不支持日期、人员筛选、统计或办理。",
      "examples": [
        "帮我看看当前有哪些未完成的待办。",
        "查看最近已完成的待办事项。"
      ],
      "apiId": "agent-todos",
      "permission": "read",
      "page": "/"
    }
  ],
  "tools": [
    {
      "id": "list-todos",
      "name": "查询待办",
      "description": "按状态查询当前员工权限范围内最近的20条待办。",
      "apiId": "tool-list-todos",
      "permission": "read",
      "mode": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "active",
              "completed"
            ],
            "maxLength": 9
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      }
    }
  ]
}
