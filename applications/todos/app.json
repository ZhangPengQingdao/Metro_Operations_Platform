{
  "id": "todos",
  "name": "待办事项",
  "version": "1.3.0",
  "description": "工班待办、车站和人员子项、周期自动任务",
  "color": "#2563EB",
  "platform": ">=1.12.0 <2.0.0",
  "permissions": [
    {
      "code": "read",
      "name": "查看待办",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "create",
      "name": "发布普通待办",
      "scopes": [
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "handle",
      "name": "办理待办子项",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "manage",
      "name": "修改及删除待办",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "recurring",
      "name": "管理周期模板",
      "scopes": [
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "score",
      "name": "设置任务分值",
      "scopes": [
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    }
  ],
  "platformAccess": [
    "people.read",
    "locations.read"
  ],
  "pages": [
    {
      "path": "/",
      "title": "待办事项",
      "permission": "read",
      "nav": true
    },
    {
      "path": "/recurring",
      "title": "周期待办",
      "permission": "recurring",
      "nav": true
    }
  ],
  "api": [
    {
      "id": "session",
      "mode": "read",
      "title": "读取当前授权信息"
    },
    {
      "id": "directory",
      "mode": "read",
      "title": "查询人员或车站"
    },
    {
      "id": "list",
      "mode": "read",
      "title": "查询待办事项",
      "documentation": {
        "description": "查询当前员工有权查看的待办或周期模板。kind为tasks表示待办，templates表示周期模板并额外要求周期管理权限。status只用于待办。按创建时间倒序，每页最多20条。nextCursor非空表示还有下一页，不能把本页数量当总数。",
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "tasks",
                "templates"
              ],
              "maxLength": 9
            },
            "organizationId": {
              "type": "string",
              "maxLength": 36,
              "description": "可选的授权组织ID；省略使用接口默认范围，不能根据组织名称编造ID",
              "format": "uuid"
            },
            "status": {
              "type": "string",
              "enum": [
                "active",
                "completed"
              ],
              "maxLength": 9
            },
            "search": {
              "type": "string",
              "maxLength": 100
            },
            "after": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "format": "uuid"
                },
                "value": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "id",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "rows"
          ],
          "additionalProperties": true
        },
        "examples": [
          {
            "title": "查询待办事项",
            "params": {
              "kind": "tasks",
              "status": "active"
            },
            "result": {
              "rows": []
            }
          }
        ],
        "errors": [
          {
            "code": "ACCESS_DENIED",
            "description": "没有操作权限或记录不在授权范围"
          },
          {
            "code": "INVALID_INPUT",
            "description": "业务参数无效"
          },
          {
            "code": "INVALID_PARAMS",
            "description": "参数不符合接口契约"
          }
        ]
      },
      "ai": {
        "examples": [
          "查看当前未完成的待办。",
          "查看最近已完成的待办。"
        ]
      },
      "expose": "apps",
      "sharedPermissions": [
        "read",
        "recurring"
      ]
    },
    {
      "id": "detail",
      "mode": "read",
      "title": "查询记录详情"
    },
    {
      "id": "create-task",
      "permission": "create",
      "mode": "write",
      "title": "创建待办"
    },
    {
      "id": "update-task",
      "permission": "manage",
      "mode": "write",
      "title": "更新待办"
    },
    {
      "id": "delete-task",
      "permission": "manage",
      "mode": "write",
      "title": "删除待办"
    },
    {
      "id": "handle-item",
      "mode": "write",
      "title": "办理待办子项"
    },
    {
      "id": "save-template",
      "permission": "recurring",
      "mode": "write",
      "title": "保存周期模板"
    },
    {
      "id": "template-state",
      "permission": "recurring",
      "mode": "write",
      "title": "修改周期模板状态"
    },
    {
      "id": "trigger",
      "mode": "write",
      "title": "执行周期任务"
    },
    {
      "id": "dashboard-summary",
      "permission": "read",
      "dashboard": true,
      "mode": "read",
      "title": "待办事项工作概况",
      "ai": {
        "examples": [
          "查看待办事项的工作概况。"
        ]
      }
    }
  ],
  "limits": {
    "memoryMiB": 128,
    "timeoutSeconds": 30
  }
}
