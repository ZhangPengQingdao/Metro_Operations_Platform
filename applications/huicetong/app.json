    },
    {
      "id": "plan-suggest",
      "mode": "draft",
      "title": "整理月度计划草稿",
      "documentation": {
        "description": "根据原话、计划提示词和部门知识库生成一条月度计划草稿，尚未提交。organizationId省略时使用本人所属部门。month必填YYYY-MM；rawText保留用户原话。责任人和日期需要核对。",
        "input": {
          "type": "object",
          "properties": {
            "organizationId": {
              "type": "string",
              "maxLength": 36,
              "description": "可选的授权组织ID；省略使用接口默认范围，不能根据组织名称编造ID",
              "format": "uuid"
            },
            "month": {
              "type": "string",
              "maxLength": 7,
              "description": "月份 YYYY-MM"
            },
            "rawText": {
              "type": "string",
              "maxLength": 1500,
              "description": "工作意图原文",
              "minLength": 1
            }
          },
          "required": [
            "month",
            "rawText"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "content": {
              "type": "string",
              "maxLength": 1500
            },
            "qualityStandard": {
              "type": "string",
              "maxLength": 1500
            }
          },
          "required": [
            "content",
            "qualityStandard"
          ],
          "additionalProperties": true
        },
        "examples": [
          {
            "title": "整理月度计划草稿",
            "params": {
              "month": "2026-11",
              "rawText": "完成设备巡检"
            },
            "result": {
              "content": "完成设备巡检",
              "qualityStandard": "形成巡检记录"
            }
          }
        ],
        "errors": [
          {
            "code": "ACCESS_DENIED",
            "description": "没有操作权限或记录不在授权范围"
          },
          {
            "code": "INVALID_INPUT",
            "description": "业务参数无效"
          },
          {
            "code": "INVALID_PARAMS",
            "description": "参数不符合接口契约"
          }
        ]
      },
      "ai": {
        "examples": [
          "帮我整理下个月的计划：完成设备巡检并完善记录。"
        ]
      },
      "permission": "fill"
    },
    {
      "id": "plan-summary",
      "permission": "read",
      "mode": "read",
      "title": "生成月度计划总结",
      "documentation": {
        "description": "对已选择的月度计划生成总结，不修改计划。ids必须是用户提供或查询返回的真实记录ID；禁止编造。organizationId省略时使用本人所属部门。",
        "input": {
          "type": "object",
          "properties": {
            "organizationId": {
              "type": "string",
              "maxLength": 36,
              "description": "可选的授权组织ID；省略使用接口默认范围，不能根据组织名称编造ID",
              "format": "uuid"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 36,
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 100
            }
          },
          "required": [
            "ids"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "summary": {
              "type": "string",
              "maxLength": 12000
            }
          },
          "required": [
            "summary"
          ],
          "additionalProperties": false
        },
        "examples": [
          {
            "title": "生成月度计划总结",
            "params": {
              "ids": [
                "00000000-0000-4000-8000-000000000001"
              ]
            },
            "result": {
              "summary": "本月计划开展设备巡检。"
            }
          }
        ],
        "errors": [
          {
            "code": "ACCESS_DENIED",
            "description": "没有操作权限或记录不在授权范围"
          },
          {
            "code": "INVALID_INPUT",
            "description": "业务参数无效"
          },
          {
            "code": "INVALID_PARAMS",
            "description": "参数不符合接口契约"
          }
        ]
      },
      "ai": {
        "examples": [
          "帮我总结所选的月度计划。"
        ]
      }
    },
    {
      "id": "settings-get",
      "mode": "read",
      "title": "读取提醒设置"
    },
    {
      "id": "settings-save",
      "mode": "write",
      "title": "保存提醒设置"
    },
    {
      "id": "reminder-list",
      "mode": "read",
      "title": "查询提醒记录"
    },
    {
      "id": "authorize-attachment",
      "mode": "read",
      "title": "校验附件权限"
    },
    {
      "id": "dashboard-summary",
      "permission": "read",
      "dashboard": true,
      "mode": "read",
      "title": "慧策通·计划督办工作概况",
      "ai": {
        "examples": [
          "查看慧策通·计划督办的工作概况。"
        ]
      }
    },
    {
      "id": "supervision-extract",
      "permission": "supervision_manage",
      "mode": "draft",
      "title": "从会议纪要提取督办草稿",
      "documentation": {
        "description": "将会议纪要中明确要求落实的事项拆成督办草稿，尚未派发，不修改业务数据。未明确的责任人和截止日期留空，需要到应用核对后派发。",
        "input": {
          "type": "object",
          "properties": {
            "notes": {
              "type": "string",
              "maxLength": 11500,
              "description": "会议纪要原文",
              "minLength": 1
            }
          },
          "required": [
            "notes"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "content": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "qualityStandard": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "endDate": {
                    "type": "string",
                    "maxLength": 10
                  },
                  "ownerName": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "content",
                  "qualityStandard",
                  "endDate",
                  "ownerName"
                ],
                "additionalProperties": false
              },
              "maxItems": 100
            }
          },
          "required": [
            "items"
          ],
          "additionalProperties": false
        },
        "examples": [
          {
            "title": "从会议纪要提取督办草稿",
            "params": {
              "notes": "请张三本月底完成设备排查。"
            },
            "result": {
              "items": []
            }
          }
        ],
        "errors": [
          {
            "code": "ACCESS_DENIED",
            "description": "没有操作权限或记录不在授权范围"
          },
          {
            "code": "INVALID_INPUT",
            "description": "业务参数无效"
          },
          {
            "code": "INVALID_PARAMS",
            "description": "参数不符合接口契约"
          }
        ]
      },
      "ai": {
        "page": "/supervision",
        "examples": [
          "把这份会议纪要整理成督办草稿。"
        ]
      }
    },
    {
      "id": "authorize-transcription",
      "permission": "supervision_manage",
      "mode": "read",
      "title": "校验转写权限"
    }
  ],
