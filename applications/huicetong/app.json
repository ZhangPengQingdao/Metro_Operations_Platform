  "api": [
    {
      "id": "session",
      "mode": "read",
      "title": "读取当前授权信息"
    },
    {
      "id": "members",
      "mode": "read",
      "title": "查询可选人员"
    },
    {
      "id": "record-list",
      "mode": "read",
      "title": "查询工作计划",
      "documentation": {
        "description": "查询授权范围内月度计划、督办或年度计划。organizationId省略时使用当前员工所属部门；kind为monthly、supervision、annual。每页8条，nextCursor用于翻页，本页数量不是总数。",
        "input": {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "monthly",
                "supervision",
                "annual"
              ],
              "maxLength": 11
            },
            "organizationId": {
              "type": "string",
              "maxLength": 36,
              "description": "可选的授权组织ID；省略使用接口默认范围，不能根据组织名称编造ID",
              "format": "uuid"
            },
            "month": {
              "type": "string",
              "maxLength": 7,
              "description": "月份 YYYY-MM"
            },
            "year": {
              "type": "integer",
              "minimum": 2000,
              "maximum": 2100
            },
            "status": {
              "type": "string",
              "enum": [
                "draft",
                "submitted",
                "in_progress",
                "completed",
                "returned"
              ],
              "maxLength": 11
            },
            "search": {
              "type": "string",
              "maxLength": 100
            },
            "mine": {
              "type": "boolean"
            },
            "after": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "format": "uuid"
                },
                "value": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "id",
                "value"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "rows"
          ],
          "additionalProperties": true
        },
        "examples": [
          {
            "title": "查询工作计划",
            "params": {
              "kind": "monthly"
            },
            "result": {
              "rows": []
            }
          }
        ],
        "errors": [
          {
            "code": "ACCESS_DENIED",
            "description": "没有操作权限或记录不在授权范围"
          },
          {
            "code": "INVALID_INPUT",
            "description": "业务参数无效"
          },
          {
            "code": "INVALID_PARAMS",
            "description": "参数不符合接口契约"
          }
        ]
      },
      "ai": {
        "examples": [
          "查看本月月度计划。",
          "查看我负责的督办。"
        ]
      },
      "expose": "apps",
      "sharedPermissions": [
        "read",
        "annual_read",
        "supervision_read"
      ]
    },
    {
      "id": "record-get",
      "mode": "read",
      "title": "查询计划详情"
    },
    {
      "id": "record-save",
      "mode": "write",
