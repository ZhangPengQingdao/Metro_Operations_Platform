  "limits": {
    "memoryMiB": 128,
    "timeoutSeconds": 30
  },
  "knowledgeBases": [
    {
      "id": "terms",
      "name": "专有名词",
      "retrieval": "exact",
      "readPermission": "fill",
      "writePermission": "corpus",
      "selfRead": true
    },
    {
      "id": "examples",
      "name": "标准示例",
      "retrieval": "similar",
      "readPermission": "fill",
      "writePermission": "corpus",
      "selfRead": true
    }
  ],
  "agents": [
    {
      "id": "monthly-plan",
      "name": "整理月度计划",
      "description": "根据员工原话和慧策通知识库整理一条月度计划草稿，缺少月份或信息时追问，不提交计划。",
      "examples": [
        "帮我整理一条下月计划：完成车站设备巡检，并完善巡检记录。",
        "我想整理月度计划，请先帮我梳理需要补充的信息。"
      ],
      "apiId": "agent-plan",
      "permission": "fill",
      "page": "/"
    }
  ],
  "tools": [
    {
      "id": "plan-reference",
      "name": "检索计划参考",
      "description": "从当前员工所属部门的计划知识库检索专有名词和标准示例。只返回有权使用的参考内容。",
      "apiId": "tool-plan-reference",
      "permission": "fill",
      "mode": "read",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1500
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      }
    }
  ]
}
