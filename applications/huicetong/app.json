      "permission": "read"
    },
    {
      "id": "cycle-confirm-signature",
      "permission": "sign"
    },
    {
      "id": "cycle-lock",
      "permission": "manage"
    },
    {
      "id": "category-list",
      "permission": "read"
    },
    {
      "id": "category-upsert",
      "permission": "manage"
    },
    {
      "id": "binding-list",
      "permission": "read"
    },
    {
      "id": "binding-upsert",
      "permission": "manage"
    },
    {
      "id": "binding-delete",
      "permission": "manage"
    },
    {
      "id": "item-list",
      "permission": "read"
    },
    {
      "id": "item-get",
      "permission": "read"
    },
    {
      "id": "item-create"
