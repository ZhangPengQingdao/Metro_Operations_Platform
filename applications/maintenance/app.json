{
  "id": "maintenance",
  "name": "检修管理",
  "version": "1.0.0",
  "description": "计划、派工、完成与检修归档",
  "color": "#0891B2",
  "platform": ">=0.30.0",
  "permissions": [
    {
      "code": "read",
      "name": "查看检修计划",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "create",
      "name": "新增检修计划",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "update",
      "name": "编辑和完成检修",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "export",
      "name": "导出检修完成情况",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "delete",
      "name": "作废未完成计划",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    }
  ],
  "platformAccess": [
    "people.read",
    "locations.read",
    "assets.read"
  ],
  "pages": [
    {
      "path": "/",
      "title": "检修管理",
      "permission": "read",
      "nav": true
    }
  ],
  "api": [
    {
      "id": "session"
    },
    {
      "id": "catalog"
    },
    {
      "id": "list",
      "permission": "read"
    },
    {
      "id": "detail",
      "permission": "read"
    },
    {
      "id": "create",
      "permission": "create"
    },
    {
      "id": "update",
      "permission": "update"
    },
    {
      "id": "delete",
      "permission": "delete"
    },
    {
      "id": "export",
      "permission": "export"
    },
    {
      "id": "dashboard-summary",
      "permission": "read",
      "dashboard": true
    }
  ],
  "limits": {
    "memoryMiB": 128,
    "timeoutSeconds": 30
  }
}
