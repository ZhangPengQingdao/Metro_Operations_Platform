{
  "id": "maintenance",
  "name": "检修管理",
  "version": "1.2.0",
  "description": "计划、派工、完成与检修归档",
  "color": "#0891B2",
  "platform": ">=1.12.0 <2.0.0",
  "permissions": [
    {
      "code": "read",
      "name": "查看检修计划",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "create",
      "name": "新增检修计划",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "update",
      "name": "编辑和完成检修",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "export",
      "name": "导出检修完成情况",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "delete",
      "name": "作废未完成计划",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    }
  ],
  "platformAccess": [
    "people.read",
    "locations.read",
    "assets.read",
    "apps.read"
  ],
  "pages": [
    {
      "path": "/",
      "title": "检修管理",
      "permission": "read",
      "nav": true
    }
  ],
  "api": [
    {
      "id": "session",
      "mode": "read",
      "title": "读取当前授权信息"
    },
    {
      "id": "catalog",
      "mode": "read",
      "title": "查询业务目录"
    },
    {
      "id": "list",
      "permission": "read",
      "mode": "read",
      "title": "查询记录"
    },
    {
      "id": "detail",
      "permission": "read",
      "mode": "read",
      "title": "查询记录详情"
    },
    {
      "id": "create",
      "permission": "create",
      "mode": "write",
      "title": "创建记录"
    },
    {
      "id": "update",
      "permission": "update",
      "mode": "write",
      "title": "更新记录"
    },
    {
      "id": "delete",
      "permission": "delete",
      "mode": "write",
      "title": "作废记录"
    },
    {
      "id": "export",
      "permission": "export",
      "mode": "read",
      "title": "导出记录"
    },
    {
      "id": "dashboard-summary",
      "permission": "read",
      "dashboard": true,
      "mode": "read",
      "title": "检修管理工作概况",
      "ai": {
        "examples": [
          "查看检修管理的工作概况。"
        ]
      },
      "expose": "apps"
    },
    {
      "id": "related-faults",
      "permission": "read",
      "mode": "read",
      "title": "查询关联故障"
    }
  ],
  "limits": {
    "memoryMiB": 128,
    "timeoutSeconds": 30
  },
  "appAccess": [
    {
      "appId": "faults",
      "apiId": "public-query"
    }
  ]
}
