{
  "id": "faults",
  "name": "故障记录",
  "version": "1.1.0",
  "description": "登记、查询、处置与导出设备故障",
  "color": "#DC2626",
  "platform": ">=1.11.0",
  "permissions": [
    {
      "code": "read",
      "name": "查看故障记录",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "create",
      "name": "新增故障记录",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "update",
      "name": "编辑和处置故障",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "export",
      "name": "导出故障记录",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "delete",
      "name": "作废故障记录",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    }
  ],
  "platformAccess": [
    "people.read",
    "locations.read",
    "assets.read"
  ],
  "pages": [
    {
      "path": "/",
      "title": "故障记录",
      "permission": "read",
      "nav": true
    }
  ],
  "api": [
    {
      "id": "session"
    },
    {
      "id": "catalog"
    },
    {
      "id": "list",
      "permission": "read"
    },
    {
      "id": "detail",
      "permission": "read"
    },
    {
      "id": "create",
      "permission": "create"
    },
    {
      "id": "update",
      "permission": "update"
    },
    {
      "id": "delete",
      "permission": "delete"
    },
    {
      "id": "export",
      "permission": "export"
    },
    {
      "id": "dashboard-summary",
      "permission": "read",
      "dashboard": true
    },
    {
      "id": "public-query",
      "permission": "read",
      "expose": {
        "title": "故障摘要查询",
        "mode": "read",
        "documentation": {
          "description": "查询当前员工有权查看的故障摘要，可按车站 ID 筛选，按发生时间倒序，每页 20 条。不会返回人员、处理详情或已作废记录。cursor 为空表示结束。",
          "input": {
            "type": "object",
            "properties": {
              "stationId": {
                "type": "string",
                "description": "公共目录中的车站 UUID；省略则查询授权范围内全部车站"
              },
              "cursor": {
                "type": "string",
                "description": "上一页返回的 cursor；首次省略"
              }
            },
            "additionalProperties": false
          },
          "output": {
            "type": "object",
            "properties": {
              "rows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "stationName": {
                      "type": "string"
                    },
                    "deviceNumber": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    },
                    "occurredAt": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "stationName",
                    "deviceNumber",
                    "description",
                    "status",
                    "occurredAt"
                  ],
                  "additionalProperties": false
                }
              },
              "cursor": {
                "type": "string"
              }
            },
            "required": [
              "rows",
              "cursor"
            ],
            "additionalProperties": false
          },
          "examples": [
            {
              "title": "查询第一页",
              "params": {},
              "result": {
                "rows": [],
                "cursor": ""
              }
            }
          ],
          "errors": [
            {
              "code": "ACCESS_DENIED",
              "description": "无目标应用查询权限或已撤权"
            },
            {
              "code": "INVALID_PARAMS",
              "description": "参数不符合接口声明"
            },
            {
              "code": "GATEWAY_FAILED",
              "description": "应用查询失败，请核对状态后重试"
            }
          ]
        }
      }
    }
  ],
  "limits": {
    "memoryMiB": 128,
    "timeoutSeconds": 30
  }
}
