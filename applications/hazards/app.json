{
  "id": "hazards",
  "name": "隐患提报 · 识隐",
  "version": "1.2.0",
  "description": "隐患识别建议、提报、治理复审与闭环案例库",
  "color": "#EA580C",
  "platform": ">=1.12.0 <2.0.0",
  "permissions": [
    {
      "code": "read",
      "name": "查看隐患记录",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "cases",
      "name": "查看闭环案例库",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "create",
      "name": "提报隐患",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "update",
      "name": "治理和完善隐患",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "review",
      "name": "复审并关闭隐患",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    },
    {
      "code": "photo",
      "name": "上传隐患留证照片",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "organizations",
        "all"
      ]
    }
  ],
  "platformAccess": [
    "locations.read",
    "people.read",
    "ai.complete"
  ],
  "pages": [
    {
      "path": "/",
      "title": "隐患记录",
      "permission": "read",
      "nav": true
    },
    {
      "path": "/cases",
      "title": "闭环案例库",
      "permission": "cases",
      "nav": true
    },
    {
      "path": "/report",
      "title": "提报隐患",
      "permission": "create",
      "nav": false
    }
  ],
  "api": [
    {
      "id": "session",
      "mode": "read",
      "title": "读取当前授权信息"
    },
    {
      "id": "catalog",
      "mode": "read",
      "title": "查询业务目录"
    },
    {
      "id": "list",
      "permission": "read",
      "mode": "read",
      "title": "查询隐患记录",
      "documentation": {
        "description": "查询授权范围内隐患，按创建时间倒序。支持状态、组织和关键词筛选；nextCursor非空时还有下一页，本页数量不是总数。",
        "input": {
          "type": "object",
          "properties": {
            "organizationId": {
              "type": "string",
              "maxLength": 36,
              "description": "可选的授权组织ID；省略使用接口默认范围，不能根据组织名称编造ID",
              "format": "uuid"
            },
            "status": {
              "type": "string",
              "enum": [
                "all",
                "open",
                "pending_review",
                "closed"
              ],
              "maxLength": 14
            },
            "search": {
              "type": "string",
              "maxLength": 100
            },
            "after": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "format": "uuid"
                },
                "value": {
                  "type": "string",
                  "maxLength": 200
                }
              },
              "required": [
                "id",
                "value"
              ],
              "additionalProperties": false
            },
            "pageSize": {
              "type": "integer",
              "minimum": 1,
              "maximum": 30
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "rows"
          ],
          "additionalProperties": true
        },
        "examples": [
          {
            "title": "查询隐患记录",
            "params": {},
            "result": {
              "rows": []
            }
          }
        ],
        "errors": [
          {
            "code": "ACCESS_DENIED",
            "description": "没有操作权限或记录不在授权范围"
          },
          {
            "code": "INVALID_INPUT",
            "description": "业务参数无效"
          },
          {
            "code": "INVALID_PARAMS",
            "description": "参数不符合接口契约"
          }
        ]
      },
      "ai": {
        "examples": [
          "查看还没有关闭的隐患。"
        ]
      },
      "expose": "apps"
    },
    {
      "id": "detail",
      "permission": "read",
      "mode": "read",
      "title": "查询记录详情"
    },
    {
      "id": "cases",
      "permission": "cases",
      "mode": "read",
      "title": "查询隐患案例"
    },
    {
      "id": "suggest",
      "permission": "create",
      "mode": "read",
      "title": "生成隐患建议"
    },
    {
      "id": "create",
      "permission": "create",
      "mode": "write",
      "title": "创建记录"
    },
    {
      "id": "update",
      "permission": "update",
      "mode": "write",
      "title": "更新记录"
    },
    {
      "id": "close",
      "permission": "review",
      "mode": "write",
      "title": "审核关闭隐患"
    },
    {
      "id": "photo-begin",
      "mode": "write",
      "title": "开始上传图片"
    },
    {
      "id": "photo-part",
      "mode": "write",
      "title": "上传图片分片"
    },
    {
      "id": "photo-finish",
      "mode": "write",
      "title": "完成图片上传"
    },
    {
      "id": "photo-read",
      "permission": "read",
      "mode": "read",
      "title": "读取隐患图片"
    }
  ],
  "limits": {
    "memoryMiB": 128,
    "timeoutSeconds": 30
  }
}
