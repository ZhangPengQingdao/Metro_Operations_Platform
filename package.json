{
  "name": "metro-operations-platform",
  "private": true,
  "version": "1.8.2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build:sdk": "npm --workspace @metro/platform-sdk run build",
    "predev": "npm run build:sdk && npm run build:cli && npm run build:developer",
    "prebuild": "npm run build:sdk && npm run build:cli && npm run build:developer",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "npm --prefix server test",
    "version:check": "node scripts/version.mjs --check",
    "version:bump": "node scripts/version.mjs",
    "pretest": "npm run build:sdk && npm run build:cli",
    "build:cli": "npm --workspace @metro/platform-cli run build",
    "build:developer": "node scripts/build-developer-assets.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@metro/platform-sdk": "1.8.2",
    "@phosphor-icons/react": "^2.1.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.0",
    "xlsx": "^0.18.5",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@types/node": "^22.14.0",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.27",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
