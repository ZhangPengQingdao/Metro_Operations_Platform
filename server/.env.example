PORT=3101
HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL=postgresql://metro:CHANGE_ME@127.0.0.1:5433/metro_operations_platform
SESSION_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
AI_PROVIDER_ENCRYPTION_KEY=CHANGE_ME_TO_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PUBLIC_BASE_URL=http://127.0.0.1:3100
CORS_ORIGIN=http://127.0.0.1:3100
COOKIE_SECURE=false
UPLOAD_DIR=../runtime/uploads
# Application management: JSON with artifactRoot and uploadRoot (see config/app-management.example.json).
# MOP_APP_MANAGEMENT_CONFIG=/absolute/path/to/Metro_Operations_Platform/runtime/app-management.json
# Development only: install every .mopkg written to this folder (used with `mop-app dev --out`).
# MOP_DEV_APPS_DIR=/absolute/path/to/dev-apps
# MOP_ADMIN_USERNAME=admin
# MOP_ADMIN_DISPLAY_NAME=平台管理员
# 密码至少 8 位，大小写字母、数字、特殊符号四类中至少三类，UTF-8 不超过 72 字节。
# MOP_ADMIN_PASSWORD=CHOOSE_YOUR_OWN_UNIQUE_PASSWORD

# Host updater socket supplied only by the Linux installer; never expose a Docker socket to API.
# MOP_UPDATER_SOCKET=/run/mop-updater/control.sock
