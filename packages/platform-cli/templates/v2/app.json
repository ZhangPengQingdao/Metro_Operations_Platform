{
  "id": "__APP_ID__",
  "name": "__APP_NAME__",
  "version": "0.1.0",
  "description": "__APP_NAME__：记录列表与新增示例",
  "color": "#2563EB",
  "platform": ">=__PLATFORM_VERSION__",
  "permissions": [
    {
      "code": "read",
      "name": "查看记录",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "all"
      ]
    },
    {
      "code": "create",
      "name": "新增记录",
      "scopes": [
        "self",
        "workgroup",
        "department",
        "all"
      ]
    }
  ],
  "platformAccess": [],
  "pages": [
    {
      "path": "/",
      "title": "记录",
      "permission": "read",
      "nav": true
    }
  ],
  "api": [
    {
      "id": "list",
      "permission": "read",
      "mode": "read",
      "title": "查询记录",
      "documentation": {
        "description": "查询当前员工有权查看的最近记录，最多50条。结果仅代表本页，不表示全部记录总数。",
        "input": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {},
                "required": [],
                "additionalProperties": true
              }
            }
          },
          "required": [
            "rows"
          ],
          "additionalProperties": true
        },
        "examples": [
          {
            "title": "查询记录",
            "params": {},
            "result": {
              "rows": []
            }
          }
        ],
        "errors": [
          {
            "code": "ACCESS_DENIED",
            "description": "没有操作权限或记录不在授权范围"
          },
          {
            "code": "INVALID_INPUT",
            "description": "业务参数无效"
          },
          {
            "code": "INVALID_PARAMS",
            "description": "参数不符合接口契约"
          }
        ]
      },
      "ai": true,
      "expose": "apps"
    },
    {
      "id": "create",
      "permission": "create",
      "mode": "write",
      "title": "创建记录",
      "documentation": {
        "description": "创建一条记录；请求号由客户端生成，使用相同请求号保证幂等。",
        "input": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 100,
              "minLength": 1
            },
            "requestId": {
              "type": "string",
              "maxLength": 36,
              "format": "uuid"
            }
          },
          "required": [
            "title",
            "requestId"
          ],
          "additionalProperties": false
        },
        "output": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 36,
              "format": "uuid"
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        "examples": [
          {
            "title": "新增示例记录",
            "params": {
              "title": "示例记录",
              "requestId": "00000000-0000-4000-8000-000000000001"
            },
            "result": {
              "id": "00000000-0000-4000-8000-000000000002"
            }
          }
        ],
        "errors": [
          {
            "code": "ACCESS_DENIED",
            "description": "没有操作权限或记录不在授权范围"
          },
          {
            "code": "INVALID_INPUT",
            "description": "业务参数无效"
          },
          {
            "code": "INVALID_PARAMS",
            "description": "参数不符合接口契约"
          }
        ]
      }
    }
  ]
}
